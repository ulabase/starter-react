    {
      "id": "claim_a8fe006220d54b57b27c626a188a76ab",
      "statement": "The setup decision tree runs the base accounts chain first (accounts feature install, branding name, accounts configuration derived from environment.ts, optional Google OAuth credentials, origin allowlist), then inserts the consents file's six gate steps (user schema, /users _meta jsonSchema attachment, acceptance permission, token claims, guards install, gate rule) before the apiUrl rewrite; the exported appPointsAtService step runs last in both files, so a half-finished setup leaves the 'connect your service' screen rather than a failing sign-up page.",
      "evidence": [
        {
