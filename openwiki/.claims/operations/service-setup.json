        }
      ]
    },
    {
      "id": "claim_7083198c8cbc4536bfa54d7b16d0b02d",
      "statement": "Setup checks are not equally deep: the acceptance permission step checks only that userCanPatchOwnConsents exists, while the guards rule step compares its full condition text and status_code. A version-bump re-run therefore rewrites the rule but leaves an existing permission's mergeRequest stamping the old versions, quietly blocking users after a form that appears to succeed — a state --dry-run reports as satisfied.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.consents.ts#L220-L224",
          "version": "repo-lines-v1:sha256:9b5c5557a1ae76521035c2ee8556c4b628e020ac6b38919c07fe8ec1d9999626:"
        },
        {
          "resource": "repo://ulabase.setup.consents.ts#L282-L293",
