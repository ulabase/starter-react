    {
      "id": "claim_d5a6d2b0460748f2bbd724341ea04545",
      "statement": "The .github/workflows/no-service-url.yml workflow ensures that no real service URL is committed to the main branch of the starter repository. It runs only in the ulabase/starter-react repository and verifies that apiUrl remains empty in all environment files.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/no-service-url.yml",
          "version": "repo-file-v1:sha256:d49a6bab6f0d4788d34bb72727446d604cfeeb279ec4115f88582a1c9b365641"
