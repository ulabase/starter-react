    {
      "id": "claim_60d379bfef654ae3bb1cc011f1f6a29f",
      "statement": "Two setup files exist: ulabase.setup.ts configures accounts, feature flags, Google OAuth, origin allowlist, and finally points the app's apiUrl at the service; ulabase.setup.consents.ts imports its steps (deferring appPointsAtService to last) and appends the consents gate documents — user schema (userConsentsSchema), users-collection validation, a scoped consent permission, JWT claims (latestConsents/tos, latestConsents/pp), guards feature install, and a Guards rule answering 451. Versions are single-sourced in TOS_VERSION and PP_VERSION constants. Both are idempotent check-then-apply via the ulabase CLI.",
      "evidence": [
        {
          "resource": "repo://README.md#L38-L62",
          "version": "repo-lines-v1:sha256:3c1809a9dcceb4ade344639b08b0d558c9b1902efbf07a686a82264afae84cec:"
