    {
      "id": "claim_a5b443d1a24d4104a2cbaf3507b03062",
      "statement": "A Guards rule on the Ulabase service blocks every authenticated request from a user whose JWT does not carry matching TOS_VERSION and PP_VERSION consent versions, responding with HTTP 451 Unavailable For Legal Reasons. The rule excludes /auth, /token, and the acceptance PATCH (method PATCH + path-template /users/{userId} + bson-request-whitelist consents), but deliberately does NOT exclude /users/me — blocking /users/me is what makes session restoration trip the gate on app load with no client-side probing.",
      "evidence": [
        {
          "resource": "repo://src/consents-signal.ts#L1-L15",
          "version": "repo-lines-v1:sha256:adfe822129e37c440bd6c3f186da8f7f2b45d7f340b40adb62c2b596efd945db:"
        },
        {
